# Web app settings. Copy to .env.local and fill in; .env.local is never
# committed. Deployed environments set these in the host's settings.

# Where waitlist signups are saved: a PostgreSQL connection string. The
# table is created by db/waitlist.sql. Without it the form says the
# signup could not be saved.
WAITLIST_DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require

# Show the log-in and sign-up pages again. Leave unset while Writ takes
# waitlist signups: the pages are not connected to Zitadel yet.
# AUTH_PAGES_ENABLED=true

# Local development settings. Copy to .env and fill in; .env is never
# committed. `make run` and `make devtoken` read it.
#
# Put only development values here. Deployed environments get theirs from
# Terraform variables and AWS Secrets Manager.

# The identity provider (Zitadel). The issuer is the instance URL with no
# trailing slash; the API compares it character for character with the
# token's iss claim.
OIDC_ISSUER=https://your-instance.zitadel.cloud

# The value the API requires in each access token's aud claim: the ID of
# the Zitadel project, not an application's client ID. See
# docs/runbooks/zitadel-smoke-test.md.
OIDC_AUDIENCE=your-zitadel-project-id

# Client ID of the Native application that `make devtoken` signs in
# through (device code grant, JWT access tokens). It is not a secret.
OIDC_DEVTOKEN_CLIENT_ID=your-native-app-client-id

# Multi-factor check. Leave off: Zitadel's access tokens currently carry
# no claim saying how the user signed in, so turning this on rejects every
# request (smoke test, step 3). The values have no default.
# OIDC_REQUIRE_MFA=true
# OIDC_MFA_CLAIM=amr
# OIDC_MFA_METHODS=value-one,value-two
